# Place inside your existing HTTPS server block.
# Root URL: http://127.0.0.1:8080; preserve the request path.
location / {
    client_max_body_size 10m;
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# Subdirectory option: set BASE_PATH=/802, and replace location / above
# with location /802/ below. No trailing slash on proxy_pass.
