# Accessible at http://SERVER_IP:8080 after deployment.
SITE_PORT=8080
BIND_ADDRESS=0.0.0.0
# Use :dev for daily builds or :v1.5.0 for a fixed release.
IMAGE=ghcr.io/paimoncai/study-econ:latest
# Empty for the domain root; use /802 for a subdirectory.
BASE_PATH=
# Required on public listeners: set at least one credential.
# Password: 12-256 characters. Use a unique long password.
ACCESS_PASSWORD=
# Token: 32-256 base64url characters; generate with the command in DEPLOY.md.
ACCESS_TOKEN=
# Set true only when using HTTPS (also enables the Secure cookie flag).
ACCESS_COOKIE_SECURE=false
ACCESS_SESSION_HOURS=168
